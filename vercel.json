{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/pyodide,src/services/runners}/**"
    }
  },
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/health",
      "dest": "/api/index.js"
    },
    {
      "src": "/health/db",
      "dest": "/api/index.js"
    }
  ]
}
