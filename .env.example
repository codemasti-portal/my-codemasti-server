# Copy to .env and fill in secrets. Connection + JWT + (optional) email + Google.
#
# Required to run the API:
#   MONGODB_URI (or MONGODB_URI_DIRECT fallback in db.js), JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# Strongly recommended:
#   BREVO_* for student/staff OTP email; CORS_ORIGIN/CORS_ORIGINS for allowed frontend origins
# Optional:
#   GOOGLE_CLIENT_ID, REFERRAL_LINK_BASE / PUBLIC_APP_URL, SUPER_ADMIN_* for seed script

PORT=5000
NODE_ENV=development

# If Brevo is not configured, OTP is logged when this is unset or not "false" (dev only).
# OTP_DEBUG_LOG=false

# Optional: seed super admin — npm run create-super-admin
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_CLUSTER=cluster0.xxxxx.mongodb.net
MONGO_DB_NAME=codemasti
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/codemasti?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI_DIRECT=mongodb://<db_username>:<db_password>@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/codemasti?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
# Comma-separated. Must include every browser origin that calls this API (no trailing slash).
# Production admin (Vercel): add your real URLs, e.g.
#   https://my-codemasti-admin-pied.vercel.app
# Student app / local dev:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://my-codemasti-com.vercel.app,https://my-codemasti-admin-pied.vercel.app
# Optional: allow any https://*.vercel.app (preview URLs). Less strict — prefer listing exact origins above.
# CORS_ALLOW_ALL_VERCEL=true

# Google Sign-In (optional). If set, id_token aud must match.
# GOOGLE_CLIENT_ID=

# ── Google Calendar + Meet (optional) — admin timetable "Meet + invites" button
# Creates a Calendar event on the organizer account, attaches a Google Meet, and emails invites
# to students in the selected batch/section (matching student list rules) plus the instructor when
# their Staff email matches the selected teacher name.
# Requirements: enable "Google Calendar API" in GCP; OAuth client (Desktop type is fine); offline
# refresh token with scope https://www.googleapis.com/auth/calendar.events
# Install dependency: npm install googleapis (listed in package.json when deployed).
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: calendar to write events to (defaults to primary calendar of refresh-token account)
# GOOGLE_CALENDAR_ID=primary
# IANA TZ for interpreting class_date + time slot times (defaults to Asia/Kolkata)
# GOOGLE_CALENDAR_TIME_ZONE=Asia/Kolkata

# Referral links in GET /v1/referral/me
# REFERRAL_LINK_BASE=https://codemasti.com/register
# PUBLIC_APP_URL=https://codemasti.com

# Cloudinary — admin note file uploads (image / PDF). Use either CLOUDINARY_URL or the three vars below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Root folder for note uploads; files go under:
#   {CLOUDINARY_NOTES_FOLDER}/images/YYYY/MM  and  .../pdfs/YYYY/MM
# CLOUDINARY_NOTES_FOLDER=codemasti/notes
# Set to false or 0 for flat folders: {root}/images and {root}/pdfs only
# CLOUDINARY_NOTES_USE_DATE=true
#
# Assignment handouts (admin/instructor) — separate tree in Cloudinary:
#   {CLOUDINARY_ASSIGNMENTS_FOLDER}/images/YYYY/MM  and  .../pdfs/YYYY/MM
# CLOUDINARY_ASSIGNMENTS_FOLDER=codemasti/assignments
# CLOUDINARY_ASSIGNMENTS_USE_DATE=true
#
# When assignment publish (release_date) is in the future, student “New assignment” in-app notifies
# are deferred until release. Set ASSIGNMENT_RELEASE_NOTIFY_SCHEDULER=0 only if another worker runs it.
# ASSIGNMENT_RELEASE_NOTIFY_SCHEDULER=1
#
# Student profile photos (admin + student app) when Cloudinary is configured:
#   {CLOUDINARY_STUDENTS_ROOT}/profiles/{mongoObjectId}/  (one folder per student)
# CLOUDINARY_STUDENTS_ROOT=codemasti/students

# Brevo (https://app.brevo.com) — verify sender in Brevo before sending
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CodeMasti
# Optional: use a Brevo template with params otp, expiresInSec
# BREVO_TEMPLATE_ID=
# BREVO_OTP_SUBJECT=Your CodeMasti login code

# Support inbox notifications (student support chat)
# SUPPORT_INBOX_EMAIL=support@codemasti.com

# LLM evaluator for coding/written assignment submissions
# Gemini is preferred (free tier: 1,500 req/day — get key at aistudio.google.com)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# DeepSeek is used as fallback if GEMINI_API_KEY is not set
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Payments mode ──────────────────────────────────────────────────────────
# Which checkout flow students see on the Fees page:
#   manual_upi  → student pays to UPI_PAYEE_VPA and uploads a screenshot; a super_admin reviews
#                 it under Billing → Manual payments and approves to mark the invoice paid.
#   phonepe     → PhonePe hosted checkout (requires the PhonePe config below + a whitelisted domain).
# Default is manual_upi. Flip to phonepe once my.codemasti.com (or the redirect domain) is whitelisted.
# PAYMENTS_MODE=manual_upi
# UPI payee for the manual flow (shown to students + encoded in the QR / upi:// deep link):
# UPI_PAYEE_VPA=
# UPI_PAYEE_NAME=
# Cloudinary folder for uploaded payment screenshots (defaults shown):
# CLOUDINARY_PAYMENT_PROOFS_FOLDER=codemasti/payments/proofs
# CLOUDINARY_PAYMENT_PROOFS_USE_DATE=true

# ── PhonePe Payment Gateway (fees / payments) — v2 (OAuth-based)
# Standard Checkout v2 flow: server fetches OAuth token → POST /checkout/v2/pay → student pays on
# PhonePe-hosted page → webhook + redirect back. Docs: https://developer.phonepe.com/
# Get CLIENT_ID/CLIENT_SECRET/CLIENT_VERSION from https://business.phonepe.com/ → Developer settings.
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# Sandbox switch: "true" routes everything to api-preprod.phonepe.com; "false" uses production hosts.
# PHONEPE_SANDBOX=true
# Where PhonePe redirects the student after payment (your student app):
# PHONEPE_REDIRECT_URL_BASE=http://localhost:3000/checkout/return
# Webhook auth: PhonePe sends Authorization: SHA256("username:password") (hex). Configure matching
# values in PhonePe dashboard → Webhooks. If left blank, webhook auth is SKIPPED with a warning
# (acceptable for dev/local, NOT for production).
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=
