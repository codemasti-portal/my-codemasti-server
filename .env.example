# CodeMasti API — environment template. Copy to .env and fill in real values (never commit .env).
# Placeholders only. Lines starting with "#" are optional; the value shown is the code default
# (or a sensible example) unless noted.
#
# Required to run the API:
#   MONGODB_URI, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# Strongly recommended:
#   BREVO_* (student/staff OTP email), CORS_ORIGINS, GOOGLE_CLIENT_ID, CRON_SECRET

# ── Production safety checklist ───────────────────────────────────────────────
# - OTP_DEBUG_LOG: OTPs are printed to stdout (when the email send fails / Brevo is not configured)
#   only if OTP_DEBUG_LOG=true, or if NODE_ENV is not "production" and OTP_DEBUG_LOG is not "false".
#   Production (Docker, deploy/restart-container.sh, Vercel) has NODE_ENV=production, so it is off
#   there unless you opt in. Leave it unset or "false" in production.
# - Set CORS_ORIGINS explicitly. If both CORS_ORIGINS and CORS_ORIGIN are empty, ANY origin
#   is reflected back with credentials enabled (a [SECURITY] warning is printed at startup when
#   NODE_ENV=production; behaviour is unchanged).
# - Set GOOGLE_CLIENT_ID if POST /v1/auth/google is to work. If it is unset the route answers 503
#   GOOGLE_NOT_CONFIGURED (it no longer skips the audience check).
# - Set PHONEPE_WEBHOOK_USERNAME and PHONEPE_WEBHOOK_PASSWORD before enabling payments via
#   PhonePe (PAYMENTS_MODE=phonepe). If blank, webhooks are unauthenticated: the server re-confirms
#   each one with PhonePe's order/refund status API before changing anything (needs PHONEPE_CLIENT_*),
#   and prints a [SECURITY] warning at startup when PAYMENTS_MODE=phonepe.
# - UPI_PAYEE_VPA / UPI_PAYEE_NAME have hard-coded fallbacks in src/utils/paymentsConfig.js that
#   production currently relies on. Set both explicitly; env always wins over the fallback.
# - CRON_SECRET is required for /v1/internal/cron/run (the endpoint returns 503 without it).

# ── Server ────────────────────────────────────────────────────────────────────
# Port for `npm run dev` / `npm start` (the admin dev proxy and Docker image use 5001).
PORT=5001
NODE_ENV=development
# Number of reverse-proxy hops to trust (e.g. 1 behind Nginx) so req.ip and rate limits use the
# real client IP. Unset = do not trust proxy headers. The EC2 deploy script sets TRUST_PROXY=1.
# TRUST_PROXY=1
# Per-IP requests/minute for the global API rate limiter (default 200). Raise only for load tests.
# RATE_LIMIT_API_MAX=200

# ── Database (MongoDB) ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/codemasti?retryWrites=true&w=majority&appName=Cluster0
# Optional non-SRV fallback. If set (and different from MONGODB_URI) it is tried FIRST — useful
# when SRV DNS is flaky locally.
# MONGODB_URI_DIRECT=mongodb://<db_username>:<db_password>@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/codemasti?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
# When the OTP email cannot be sent (Brevo not configured / error) the OTP can be printed to stdout:
#   "true"  -> always print (any NODE_ENV; avoid in production, anyone with log access can log in)
#   "false" -> never print
#   unset   -> print only when NODE_ENV is not "production" (local dev default)
# OTP_DEBUG_LOG=false
# Google Sign-In (student login, POST /v1/auth/google). Required for that route: the id_token "aud"
# must match. If unset the route returns 503 GOOGLE_NOT_CONFIGURED.
# GOOGLE_CLIENT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call this API (no trailing slash).
# If both CORS_ORIGINS and CORS_ORIGIN are empty, every origin is reflected with credentials
# (a [SECURITY] warning is logged at startup in production). Always set this in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://my-codemasti-com.vercel.app,https://my-codemasti-admin-pied.vercel.app
# Legacy alias of CORS_ORIGINS; both are read and merged. Prefer CORS_ORIGINS.
# CORS_ORIGIN=

# ── Super admin bootstrap — npm run create-super-admin ────────────────────────
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin

# ── Public app URLs (used in emails and links) ────────────────────────────────
# Student portal base URL for email deep links.
# STUDENT_PORTAL_URL=https://my.codemasti.com
# Staff/admin portal base URL for email deep links (instructor assignments, mentor sessions, etc.).
# ADMIN_PORTAL_URL=https://my-codemasti-admin-pied.vercel.app
# Referral links in GET /v1/referral/me: {REFERRAL_LINK_BASE}, else {PUBLIC_APP_URL}/register.
# REFERRAL_LINK_BASE=https://codemasti.com/register
# PUBLIC_APP_URL=https://codemasti.com
# Base URL for contest result links (the registration id is appended as ?cst=...).
# CONTEST_RESULTS_BASE_URL=https://counsellor.codemasti.com/result

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# https://app.brevo.com — verify the sender in Brevo before sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CodeMasti
# Optional: use a Brevo template with params otp, expiresInSec.
# BREVO_TEMPLATE_ID=
# BREVO_OTP_SUBJECT=Your CodeMasti login code
# Support inbox: recipient of student support-chat emails and the contact shown in notification emails.
# SUPPORT_EMAIL=support@codemasti.com
# Notification email branding (all optional; defaults shown).
# EMAIL_LOGO_URL=https://example.com/logo.png
# EMAIL_BRAND_PRIMARY=#f97316
# EMAIL_BRAND_PRIMARY_DARK=#ea580c
# EMAIL_BRAND_HEADER_FROM=#0b1220
# EMAIL_BRAND_HEADER_TO=#1f2937

# ── Google Calendar + Meet (optional) — admin timetable "Meet + invites" button ─
# Creates a Calendar event on the organizer account, attaches a Google Meet, and emails invites
# to students in the selected batch/section (matching student list rules) plus the instructor when
# their Staff email matches the selected teacher name.
# Requirements: enable "Google Calendar API" in GCP; OAuth client (Desktop type is fine); offline
# refresh token with scope https://www.googleapis.com/auth/calendar.events
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# Calendar to write events to (defaults to the primary calendar of the refresh-token account).
# GOOGLE_CALENDAR_ID=primary
# IANA time zone for interpreting class_date + time-slot times (default Asia/Kolkata). Also used by
# class reminder scheduling — keep it correct so emails fire at the right local time.
# GOOGLE_CALENDAR_TIME_ZONE=Asia/Kolkata
# (GOOGLE_CALENDAR_TIMEZONE, without the underscore, is also accepted as an alias.)
# Explicit override for class times (falls back to GOOGLE_CALENDAR_TIME_ZONE, then Asia/Kolkata).
# CLASS_TIMEZONE=Asia/Kolkata

# ── Schedulers and cron ───────────────────────────────────────────────────────
# Shared secret for the cron trigger endpoint (GET/POST /v1/internal/cron/run, sent as the
# x-cron-secret header or ?key= query param). An external pinger (e.g. cron-job.org) calls it every
# minute to run reminder ticks on Vercel, where in-process timers never fire.
# CRON_SECRET=replace-with-a-long-random-string
# Post-class / post-mentor-session task notifications (instructor upload + assignment; mentor upload).
# ISO-8601 instant — sessions ending BEFORE this time never receive post-session tasks (rollout safety).
# If unset or malformed, the post-session task scheduler is disabled (fail-safe).
# POST_SESSION_TASKS_START_AT=2026-03-15T00:00:00+05:30
# When an assignment's release_date is in the future, the student "New assignment" in-app notice is
# deferred until release. Set to 0 only if another worker runs the release scheduler.
# ASSIGNMENT_RELEASE_NOTIFY_SCHEDULER=1
# Monthly billing invoice scheduler (server.js runtime). Set to 0 to disable.
# BILLING_INVOICE_SCHEDULER=1
# Notification retention (days). Read/unread student notifications and staff panel notifications
# older than these are deleted by the cleanup scheduler.
# STUDENT_NOTIF_DELETE_READ_AFTER_DAYS=30
# STUDENT_NOTIF_DELETE_UNREAD_AFTER_DAYS=120
# STAFF_NOTIF_DELETE_AFTER_DAYS=180

# ── Cloudinary (all file uploads: notes, assignments, avatars, proofs, ...) ───
# Use either CLOUDINARY_URL or the three vars below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Each *_FOLDER sets the root; files go under {root}/images/YYYY/MM and .../pdfs/YYYY/MM.
# Set the matching *_USE_DATE to false or 0 for flat folders: {root}/images and {root}/pdfs only.
# Notes (admin note files):
# CLOUDINARY_NOTES_FOLDER=codemasti/notes
# CLOUDINARY_NOTES_USE_DATE=true
# Assignment handouts (admin/instructor):
# CLOUDINARY_ASSIGNMENTS_FOLDER=codemasti/assignments
# CLOUDINARY_ASSIGNMENTS_USE_DATE=true
# Assignment question assets:
# CLOUDINARY_ASSIGNMENT_QUESTIONS_FOLDER=codemasti/assignments/questions
# CLOUDINARY_ASSIGNMENT_QUESTIONS_USE_DATE=true
# Community chat attachments:
# CLOUDINARY_COMMUNITY_FOLDER=codemasti/community
# CLOUDINARY_COMMUNITY_USE_DATE=true
# Doubts attachments:
# CLOUDINARY_DOUBTS_FOLDER=codemasti/doubts
# CLOUDINARY_DOUBTS_USE_DATE=true
# Badge program artwork:
# CLOUDINARY_BADGE_PROGRAMS_FOLDER=codemasti/badge-programs
# CLOUDINARY_BADGE_PROGRAMS_USE_DATE=true
# Manual UPI payment proof screenshots:
# CLOUDINARY_PAYMENT_PROOFS_FOLDER=codemasti/payments/proofs
# CLOUDINARY_PAYMENT_PROOFS_USE_DATE=true
# Student profile photos: {CLOUDINARY_STUDENTS_ROOT}/profiles/{mongoObjectId}/ (one folder per student).
# CLOUDINARY_STUDENTS_ROOT=codemasti/students
# Staff profile photos + resumes: {CLOUDINARY_STAFF_ROOT}/profiles/{mongoObjectId}/ (one folder per staff member).
# CLOUDINARY_STAFF_ROOT=codemasti/staff

# ── AI evaluator for coding/written assignment submissions ────────────────────
# Gemini is preferred (free tier: 1,500 req/day — get a key at aistudio.google.com).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# DeepSeek is used as a fallback if GEMINI_API_KEY is not set.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Payments ──────────────────────────────────────────────────────────────────
# Which checkout flow students see on the Fees page:
#   manual_upi  → student pays to UPI_PAYEE_VPA and uploads a screenshot; a super_admin reviews
#                 it under Billing → Manual payments and approves to mark the invoice paid.
#   phonepe     → PhonePe hosted checkout (requires the PhonePe config below + a whitelisted domain).
# Default is manual_upi. Flip to phonepe once my.codemasti.com (or the redirect domain) is whitelisted.
# PAYMENTS_MODE=manual_upi
# UPI payee for the manual flow (shown to students + encoded in the QR / upi:// deep link).
# If unset, hard-coded fallbacks in src/utils/paymentsConfig.js are used (production relies on them
# today). Set both explicitly so the payee is visible in config rather than hidden in code.
# UPI_PAYEE_VPA=
# UPI_PAYEE_NAME=

# ── PhonePe Payment Gateway (fees / payments) — v2 (OAuth-based) ──────────────
# Standard Checkout v2 flow: server fetches OAuth token → POST /checkout/v2/pay → student pays on
# PhonePe-hosted page → webhook + redirect back. Docs: https://developer.phonepe.com/
# Get CLIENT_ID/CLIENT_SECRET/CLIENT_VERSION from https://business.phonepe.com/ → Developer settings.
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# Sandbox switch: "true" routes everything to api-preprod.phonepe.com; "false" uses production hosts.
# PHONEPE_SANDBOX=true
# Where PhonePe redirects the student after payment (your student app):
# PHONEPE_REDIRECT_URL_BASE=http://localhost:3000/checkout/return
# Webhook auth: PhonePe sends Authorization: SHA256("username:password") (hex). Configure matching
# values in PhonePe dashboard → Webhooks. If left blank, the Authorization header cannot be checked;
# each webhook is then re-confirmed via PhonePe's order/refund status API (needs the PHONEPE_CLIENT_*
# values above) before it changes any payment/invoice/refund, and a [SECURITY] warning is logged at
# startup when PAYMENTS_MODE=phonepe. Set both for production.
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=
